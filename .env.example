# Copy this file to `.env` and fill in your own credentials.
# Every key below is OPTIONAL: without it the matching enrichment step is
# skipped and the app falls back to locally computed feature values.

# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# https://urlscan.io/user/apikey
URLSCAN_API_KEY=

# https://whois.whoisxmlapi.com/
WHOISXML_API_KEY=
